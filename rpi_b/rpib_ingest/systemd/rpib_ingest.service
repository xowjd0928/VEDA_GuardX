[Unit]
Description=GuardX RPi B - sensor/button ingest (rpib_engine 3분할, A->B)
After=mosquitto.service network-online.target
Wants=mosquitto.service network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/guardx/rpib/ingest
ExecStart=/opt/guardx/rpib/ingest/app/rpib_ingest
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

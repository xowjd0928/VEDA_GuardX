[Unit]
Description=GuardX RPi B - fire response dispatch (rpib_engine 3분할, B->C)
After=mosquitto.service network-online.target
Wants=mosquitto.service network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/guardx/rpib/dispatch
ExecStart=/opt/guardx/rpib/dispatch/app/rpib_dispatch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

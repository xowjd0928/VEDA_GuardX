# config.env — guardx_poller 설정 (rpi_b 루트에 배치)
# 셸 호환: source 해도 되고, 폴러가 파일로 직접 읽기도 함 (환경변수가 우선)
# ⚠ 비밀번호 포함 — git에 올리지 말 것

export CAM_HOST=192.168.0.3
export CAM_USER=admin                 # 운영: 폴링 전용 계정 권장
export CAM_PASS='CHANGE_ME'
# 쓰기 계정 — 적재와 cmd/* 처리. INSERT/UPDATE/SELECT 만 가진다.
# ⚠ 이 값을 `user=juan` 으로 두지 말 것. juan 은 postgres 소유 테이블에
#   DELETE·TRUNCATE 까지 갖는 반면(camera_credentials 포함) fire_schema.sql
#   계열에는 권한이 하나도 없어, 화재·센서 발행이 조용히 전멸한다
#   (2026-08-11 운영 DB 실측. publishVmsState 가 토픽별로 예외를 삼키고
#    기동 시 경고 한 줄만 찍기 때문에 화면이 그냥 비어 보인다).
export PGCONN='host=localhost dbname=guardx user=guardx_writer password=CHANGE_ME'

# 조회 전용 계정 — guardx_mqttd 의 query/* 응답과 상태 발행이 쓴다.
# 생략하면 PGCONN 으로 폴백하고 기동 로그에 경고가 찍힌다(롤 분리 무효).
# ⚠ 비밀번호를 PGCONN 과 다르게 둘 것. 같으면 계정을 갈라도 탈취 시
#   피해 범위가 그대로다 — Database/init.sql 은 3롤을 같은 값으로 만든다.
export PGCONN_RO='host=localhost dbname=guardx user=guardx_reader password=CHANGE_ME'

# 작업 F 과도기 스위치. 0 = 토큰 **없는** 쓰기 명령(set_zone·set_actuator·
# set_fire_threshold)을 경고 로그와 함께 허용한다. VMS 전 대수가 로그인 붙은
# 버전으로 배포된 것을 확인한 뒤 1 로 올린다.
# ⚠ 관대해지는 것은 "토큰 없음"뿐이다 — 틀린 토큰은 이 값과 무관하게 거부한다.
#export REQUIRE_TOKEN=1

export CAM_INSECURE=1                 # 테스트 전용. 운영=0 + 인증서 고정
export STATE_PATH=./state/poller_state.json

# 폴링 주기(초) — 생략 시 기본값
#export DET_INTERVAL_S=2
#export PRED_INTERVAL_S=60    # 모델이 1분 해상도 — 10초로 줄여도 새 정보 없음 (v13)
#export CFG_INTERVAL_S=30
#export CAMERA_ID=1
#export CHANNEL=1
# v14 다채널: 폴링할 채널 목록. 실측(2026-07-27) 채널은 0-기반 (센서 0~3).
# 전 채널 폴링 — 통행 없는 채널은 warmup skip만 하므로 부담 없음 (카메라
# 이동 시에도 설정 변경 불필요)
#export CHANNELS=0,1,2,3
# v15 faces 피드 주기(초) — 생략 시 10
#export FACE_INTERVAL_S=10
# CAP /analytics/trajectories polling interval in seconds. Default: 5
#export TRAJECTORY_INTERVAL_S=5

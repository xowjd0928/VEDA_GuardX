# GuardX RPi C - RS-485 USB 변환기(SZH-CVBE-008, CH340)에 고정 별칭을 준다.
#
#   /dev/guardx-rs485 -> /dev/ttyUSB<N>
#
# 왜 필요한가: 변환기를 뽑았다 꽂으면 커널이 다음 번호를 준다(ttyUSB0 -> 1 -> 0).
# 그래서 경로를 박아두면 "No such file or directory" 로 실패하는데, 원인이
# 배선처럼 보여서 시간을 크게 잃는다.
#
# CH340 은 시리얼 번호가 없어(SerialNumber=0) VID/PID 로만 구분한다. 같은 칩
# 어댑터를 하나 더 달면 이 규칙이 둘 다 잡으므로, 그때는 USB 포트 경로로
# 나눠야 한다. 예: KERNELS=="1-1.1" 을 조건에 추가.
#
# 설치는 install.sh 가 한다. 손으로 할 때는:
#   sudo cp 99-guardx-rs485.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   # 변환기를 다시 꽂거나:  sudo udevadm trigger --subsystem-match=tty --action=add

ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyUSB[0-9]*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", GROUP="dialout", MODE="0660", SYMLINK+="guardx-rs485"

[Unit]
Description=GuardX RPi C - rpic_pca9685 kernel module (servo x2 + fan)
# 컨벤션: 노드별 독립 유닛, Type=oneshot
DefaultDependencies=no
Before=rpic_subscriber.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/insmod /opt/guardx/rpic/drivers/rpic_pca9685.ko
ExecStop=/sbin/rmmod rpic_pca9685

[Install]
WantedBy=multi-user.target

[Unit]
Description=GuardX RPi C - rpic_pump kernel module (HG7881 water pump)
# 컨벤션: 노드별 독립 유닛, Type=oneshot
DefaultDependencies=no
Before=rpic_subscriber.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/insmod /opt/guardx/rpic/drivers/rpic_pump.ko
ExecStop=/sbin/rmmod rpic_pump

[Install]
WantedBy=multi-user.target
